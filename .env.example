SAGE_APP_NAME=SAGE
SAGE_ENVIRONMENT=development
SAGE_DEBUG=true

SAGE_DATABASE_PATH=data/sage.db

SAGE_MODEL_REQUEST_TIMEOUT=60

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Nebius AI
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Voice (optional)
SAGE_FEATURE_VOICE=0
SAGE_VOICE_CHATTERBOX_URL=https://tts.thecloverforge.com/tts
SAGE_VOICE_TTS_CLIENT_CHUNKING=true
SAGE_VOICE_TTS_CHUNK_CHARS=220
SAGE_VOICE_TTS_PREFETCH=2
SAGE_VOICE_TTS_TIMEOUT_SECONDS=30
